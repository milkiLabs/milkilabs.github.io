---
interface Props {
    number: string;
    title: string;
    description: string;
    icon: string;
}

const { number, title, description, icon } = Astro.props;
---

<div
    class="group relative p-6 md:p-8 rounded-2xl bg-white border border-cream-300 hover:border-earth-400 transition-all hover-lift"
>
    <!-- Number badge -->
    <div
        class="absolute -top-3 -right-3 w-10 h-10 rounded-full bg-earth-800 text-cream-100 flex items-center justify-center font-display font-bold text-sm shadow-lg"
    >
        {number}
    </div>

    <!-- Icon -->
    <div
        class="w-14 h-14 rounded-xl bg-gradient-to-br from-cream-200 to-cream-300 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform"
    >
        {icon}
    </div>

    <h3 class="font-display text-xl font-bold text-earth-900 mb-2">{title}</h3>
    <p class="text-ink-600 leading-relaxed">{description}</p>
</div>
