---
import ProjectCard from "./ProjectCard.astro";
// import TasksAppIcon from '../assets/tasks-app.svg'
// import ZikraAppIcon from '../assets/zikra-icon.svg'
import LauncherAppIcon from '../assets/milki-launcher-icon.svg'

const projects = [
{
    name: "Milki Launcher",
    tagline: "A home screen built around search",
    description:
        "A free and open source Android launcher built entirely from scratch. Search apps, contacts, files, and the web from one place, with no ads, no tracking, and no telemetry.",
    link: "https://milkilabs.github.io/launcher/",
    icon: LauncherAppIcon,
    features: [
        "Search-first home screen for apps, contacts, files, and the web",
        "Clipboard-aware suggestions and smart URL detection",
        "Custom search prefixes, like w for Wikipedia",
        "Custom gestures and actions",
        "No ads, no tracking, no telemetry",
    ],
    gradient:
        "bg-gradient-to-br from-slate-600 to-slate-800 text-cream-100",
},
    // {
    //     name: "Milki Tasks",
    //     tagline: "A place to do what matters",
    //     description:
    //         "A task manager that puts you in control. Works completely offline, syncs on your terms, and keeps your tasks where they belong—with you.",
    //     link: "https://milkilabs.github.io/tasks/",
    //     icon: TasksAppIcon,
    //     features: [
    //         "Works offline, always",
    //         "User-controlled sync via RemoteStorage",
    //         "No account required to use",
    //         "Your data stays on your device",
    //     ],
    //     gradient:
    //         "bg-gradient-to-br from-earth-600 to-earth-800 text-cream-100",
    // },
    // {
    //     name: "Zikra",
    //     tagline: "A place to remember what matters",
    //     description:
    //         "A personal, local-first learning archive. Capture resources from YouTube, books, articles, papers, and more. Organize your knowledge and track your learning journey.",
    //     link: "https://milkilabs.github.io/zikra/",
    //     icon: ZikraAppIcon,
    //     features: [
    //         "Capture from YouTube, articles, books & papers",
    //         "Organize with playlists and collections",
    //         "Track your learning progress",
    //         "Fully offline-capable",
    //     ],
    //     gradient:
    //         "bg-gradient-to-br from-accent-500 to-accent-600 text-cream-100",
    // },
];
---

<section
    id="projects"
    class="py-24 md:py-32 bg-gradient-to-b from-cream-100 to-cream-200"
>
    <div class="max-w-6xl mx-auto px-6">
        <!-- Section header -->
        <div class="text-center mb-16">
            <span
                class="inline-block px-4 py-1.5 rounded-full bg-earth-200 text-earth-700 text-sm font-medium mb-4"
                >Our Projects</span
            >
            <h2
                class="font-display text-4xl md:text-5xl font-bold text-earth-900 mb-4"
            >
                Tools that respect you
            </h2>
            <p class="text-xl text-ink-600 max-w-2xl mx-auto text-balance">
                Each tool is designed to work independently, yet shares a common
                philosophy: local-first, user-owned, open.
            </p>
        </div>

        <!-- Projects grid -->
        <div class="grid md:grid-cols-2 gap-8">
            {projects.map((project) => <ProjectCard {...project} />)}
        </div>

        <!-- Coming soon teaser -->
        <div class="mt-12 text-center">
            <div
                class="inline-flex items-center gap-3 px-6 py-4 rounded-2xl bg-white border border-cream-300 shadow-sm"
            >
                <div class="flex -space-x-2">
                    <div
                        class="w-8 h-8 rounded-full bg-earth-200 flex items-center justify-center text-sm"
                    >
                        📝
                    </div>
                    <div
                        class="w-8 h-8 rounded-full bg-earth-300 flex items-center justify-center text-sm"
                    >
                        🎯
                    </div>
                    <div
                        class="w-8 h-8 rounded-full bg-earth-400 flex items-center justify-center text-sm"
                    >
                        💭
                    </div>
                </div>
                <span class="text-ink-600">More tools in development...</span>
            </div>
        </div>
    </div>
</section>
