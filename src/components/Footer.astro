---
// Footer component
const currentYear = new Date().getFullYear();
---

<footer class="bg-earth-950 text-cream-200 py-16">
    <div class="max-w-6xl mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-12 mb-12">
            <!-- Brand -->
            <div class="md:col-span-2">
                <a href="/" class="flex items-center gap-3 mb-4">
                    <div
                        class="w-10 h-10 rounded-xl bg-gradient-to-br from-earth-600 to-earth-700 flex items-center justify-center"
                    >
                        <span
                            class="text-cream-100 font-display font-bold text-lg"
                            >M</span
                        >
                    </div>
                    <span
                        class="font-display font-semibold text-xl text-cream-100"
                        >Milki Labs</span
                    >
                </a>
                <p class="text-earth-400 leading-relaxed max-w-sm mb-6">
                    Local-first personal tools, owned by you. Open source,
                    transparent, and built with respect for user autonomy.
                </p>
                <div class="flex items-center gap-4">
                    <a
                        href="https://github.com/milkilabs"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-lg bg-earth-800 hover:bg-earth-700 flex items-center justify-center transition-colors"
                        aria-label="GitHub"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Projects -->
            <div>
                <h4 class="font-display font-bold text-cream-100 mb-4">
                    Projects
                </h4>
                <ul class="space-y-2">
                    <li>
                        <a
                            href="https://milkilabs.github.io/tasks/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-earth-400 hover:text-cream-100 transition-colors"
                        >
                            Milki Tasks
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://milkilabs.github.io/zikra/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-earth-400 hover:text-cream-100 transition-colors"
                        >
                            Zikra
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Links -->
            <div>
                <h4 class="font-display font-bold text-cream-100 mb-4">
                    Resources
                </h4>
                <ul class="space-y-2">
                    <li>
                        <a
                            href="#manifesto"
                            class="text-earth-400 hover:text-cream-100 transition-colors"
                        >
                            Manifesto
                        </a>
                    </li>
                    <li>
                        <a
                            href="#principles"
                            class="text-earth-400 hover:text-cream-100 transition-colors"
                        >
                            Principles
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://github.com/milkilabs"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-earth-400 hover:text-cream-100 transition-colors"
                        >
                            Contribute
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Bottom bar -->
        <div
            class="pt-8 border-t border-earth-800 flex flex-col sm:flex-row items-center justify-between gap-4"
        >
            <p class="text-earth-500 text-sm">
                © {currentYear} Milki Labs. Open source under MIT license.
            </p>
            <p class="text-earth-500 text-sm flex items-center gap-2">
                Made with
                <span class="text-red-400">♥</span>
                for user autonomy
            </p>
        </div>
    </div>
</footer>
