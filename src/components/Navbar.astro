---
import Leaf from '../../public/favicon.svg'
// Navbar component
---

<nav class="fixed top-0 left-0 right-0 z-50 glass">
    <div class="max-w-6xl mx-auto px-6 py-4">
        <div class="flex items-center justify-between">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-3 group">
                <div
                    class="w-10 h-10 rounded-xl bg-gradient-to-br flex items-center justify-center shadow-lg group-hover:shadow-xl transition-shadow"
                >
                    <Leaf class="w-6 h-6" />
                </div>
                <span class="font-display font-semibold text-xl text-earth-900"
                    >Milki Labs</span
                >
            </a>

            <!-- Navigation Links -->
            <div class="hidden md:flex items-center gap-8">
                <a
                    href="#projects"
                    class="text-ink-600 hover:text-earth-700 transition-colors font-medium"
                    >Projects</a
                >
                <a
                    href="#principles"
                    class="text-ink-600 hover:text-earth-700 transition-colors font-medium"
                    >Principles</a
                >
                <a
                    href="#manifesto"
                    class="text-ink-600 hover:text-earth-700 transition-colors font-medium"
                    >Manifesto</a
                >
                <a
                    href="https://github.com/milkilabs"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 px-4 py-2 rounded-full bg-earth-900 text-cream-100 hover:bg-earth-800 transition-colors font-medium"
                >
                    <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
                        ></path>
                    </svg>
                    GitHub
                </a>
            </div>

            <!-- Mobile Menu Button -->
            <button
                id="mobile-menu-btn"
                class="md:hidden p-2 rounded-lg hover:bg-cream-200 transition-colors"
                aria-label="Toggle menu"
            >
                <svg
                    class="w-6 h-6 text-earth-800"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div
            id="mobile-menu"
            class="hidden md:hidden mt-4 pb-4 border-t border-cream-300"
        >
            <div class="flex flex-col gap-4 pt-4">
                <a
                    href="#projects"
                    class="text-ink-600 hover:text-earth-700 transition-colors font-medium"
                    >Projects</a
                >
                <a
                    href="#principles"
                    class="text-ink-600 hover:text-earth-700 transition-colors font-medium"
                    >Principles</a
                >
                <a
                    href="#manifesto"
                    class="text-ink-600 hover:text-earth-700 transition-colors font-medium"
                    >Manifesto</a
                >
                <a
                    href="https://github.com/milkilabs"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 text-earth-700 font-medium"
                >
                    <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
                        ></path>
                    </svg>
                    GitHub
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    mobileMenuBtn?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
    });

    // Close menu when clicking on links
    document.querySelectorAll("#mobile-menu a").forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu?.classList.add("hidden");
        });
    });
</script>
